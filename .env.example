# Copie para .env e ajuste. Nunca suba o .env para o git.
PORT=3000

# "mock" simula o Pix (so para desenvolvimento). "mercadopago" cobra de verdade.
PIX_PROVIDER=mock
# Obrigatorio com PIX_PROVIDER=mercadopago (token de producao da sua conta)
MERCADOPAGO_ACCESS_TOKEN=
# URL publica do site, para o Mercado Pago avisar os pagamentos (ex.: https://seusite.com.br)
PUBLIC_BASE_URL=

# Senha do painel /admin.html
ADMIN_PASSWORD=troque-esta-senha
# Segredo que o PC ligado ao PS5 usa para avisar que o console esta online
HOST_SECRET=troque-este-segredo

# Ponha true quando o site estiver em HTTPS (o cookie de login so vai por HTTPS)
COOKIE_SECURE=false
# Video do PS5 por WebRTC (MediaMTX). Ex.: http://localhost:8889/ps5/whep  (tem prioridade sobre STREAM_EMBED_URL)
WHEP_URL=
# Servidor STUN (ajuda o WebRTC a achar o caminho). Pode deixar como esta.
STUN_URL=stun:stun.l.google.com:19302
# Alternativa: live externa (URL https de "embed" da Kick/Twitch/YouTube). Vazio = sem video
STREAM_EMBED_URL=

# Tempo (minutos) que um Pix gerado fica valido
PIX_EXPIRES_MIN=15

# ---- Leilao (valores em reais) ----
# Piso do leilao: R$ por minuto (1 = "R$ 10 por 10 minutos" e o menor lance possivel)
BID_MIN_REAIS_PER_MINUTE=1
BID_MIN_MINUTES=5
BID_MAX_MINUTES=60
BID_STEP_MINUTES=5
BID_MAX_REAIS=200

# ---- Fila gratis ----
FREE_MINUTES=10
# Depois de quantos turnos pagos entra 1 turno gratis (0 = gratis so quando nao ha pagantes na fila)
FREE_EVERY=3
# Minutos de espera entre dois turnos gratis da mesma conta
FREE_COOLDOWN_MIN=60
FREE_MAX_QUEUE=20

# ---- Quem opera o site (aparece nas paginas Termos de uso e Privacidade) ----
OPERATOR_NAME=
CONTACT_EMAIL=

# Link do codigo-fonte da sua versao (AGPL: se voce modificar e colocar no ar, ofereca o codigo). Ex.: https://github.com/seu-usuario/lanhouse-ps5
SOURCE_URL=

# ---- Cadastro ----
# true (padrao): a conta so entra depois de digitar o codigo enviado ao e-mail. Exige e-mail funcionando (MAIL_PROVIDER=smtp).
# false: so para teste local, sem e-mail.
REQUIRE_EMAIL_VERIFICATION=true
# Contas novas por hora por aparelho (IP)
REGISTER_PER_HOUR=10

# ---- E-mail (confirmar cadastro e recuperar senha, por codigo) ----
# console = NAO envia nada: o codigo aparece no log do servidor (so para testar). smtp = envia de verdade.
MAIL_PROVIDER=console
MAIL_FROM=Lan House PS5 <nao-responder@seudominio.com.br>
SMTP_HOST=
SMTP_PORT=587
# true = porta 465 (TLS direto). false = 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
